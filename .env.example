# =============================================================================
# FrontDesk Nexus — copy to Web/.env (never commit .env)
# =============================================================================
#
# VITE_* variables are embedded in the browser bundle — never put secrets there.
#
# Dual PMS room data: VPS bridge (bridge/ + PM2) copies Postgres → Supabase.
# =============================================================================

# --- Supabase (browser) ---
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# --- Optional: property label ---
VITE_HOTEL_NAME=Your property name

# --- Optional: guest PII encryption (browser) ---
# VITE_PII_ENCRYPTION_KEY=base64_32byte_key

# --- Optional: idle auto sign-out (default 28800000 ms = 8 hours) ---
# VITE_IDLE_LOGOUT_MS=28800000

# --- Chrome extension (build-time; required for production / Vercel) ---
VITE_CHROME_EXTENSION_ID=oellgjjhompcikojenbbfepojdcpnpla

# --- Optional: audit_log.terminal_id (UUID from public.terminals) ---
VITE_TERMINAL_ID=

# --- Supabase edge secrets (Dashboard → Edge Functions → Secrets) ---
# EZEE_SECRETS_KEY=encrypts eZee, SynXis passwords in app_settings
# PMS_SYNC_CRON_SECRET=optional_cron_auth_for_pms-sync
